<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.SmartInventory" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/primary_blue</item>
        <item name="colorOnPrimary">@color/white</item>

        <!-- Status bar color. -->
        <item name="android:statusBarColor">@color/bg_main</item>
        <item name="android:windowLightStatusBar">true</item>

        <!-- Background colors -->
        <item name="android:windowBackground">@color/bg_main</item>

        <!-- Default Styles for Components -->
        <item name="materialCardViewStyle">@style/Widget.SmartInventory.Card</item>
        <item name="materialButtonStyle">@style/Widget.SmartInventory.Button</item>
        <item name="textInputStyle">@style/Widget.SmartInventory.TextInputLayout</item>
    </style>

    <style name="Theme.SmartInventory" parent="Base.Theme.SmartInventory" />

    <!-- Premium Card Style: Flat with subtle border (Notion-like) -->
    <style name="Widget.SmartInventory.Card" parent="Widget.Material3.CardView.Elevated">
        <item name="cardElevation">0dp</item>
        <item name="cardCornerRadius">16dp</item>
        <item name="strokeColor">@color/divider</item>
        <item name="strokeWidth">1dp</item>
        <item name="cardBackgroundColor">@color/surface_white</item>
    </style>

    <!-- Modern Button Style -->
    <style name="Widget.SmartInventory.Button" parent="Widget.Material3.Button">
        <item name="android:textAllCaps">false</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="cornerRadius">12dp</item>
        <item name="android:paddingVertical">12dp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- Clean TextInputLayout Style -->
    <style name="Widget.SmartInventory.TextInputLayout" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxCornerRadiusTopStart">12dp</item>
        <item name="boxCornerRadiusTopEnd">12dp</item>
        <item name="boxCornerRadiusBottomStart">12dp</item>
        <item name="boxCornerRadiusBottomEnd">12dp</item>
        <item name="boxStrokeColor">@color/primary_blue</item>
        <item name="hintTextColor">@color/primary_blue</item>
    </style>
</resources>
